<?xml version="1.0" encoding="utf-8"?>
<!-- Ongoing-call custom notification bar. Height capped at 48dp: Android docs say
     collapsed custom content can be limited to as little as 48dp on some versions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_call_name"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/notif_call_status"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <Chronometer
            android:id="@+id/notif_call_timer"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/notif_btn_mute"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/notif_btn_circle"
        android:contentDescription="Mute"
        android:padding="7dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_notif_mute" />

    <ImageButton
        android:id="@+id/notif_btn_speaker"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/notif_btn_circle"
        android:contentDescription="Speaker"
        android:padding="7dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_notif_speaker" />

    <ImageButton
        android:id="@+id/notif_btn_end"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/notif_btn_circle_end"
        android:contentDescription="Call kaato"
        android:padding="7dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_notif_call_end" />
</LinearLayout>
